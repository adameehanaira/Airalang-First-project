import "sec";

fn print_banner() {
    say "";
    say "\033[1;36m    ___    _            ____                  \033[0m";
    say "\033[1;36m   /   |  (_)________ _/ ___/_________ _____  \033[0m";
    say "\033[1;36m  / /| | / / ___/ __ `/\__ \/ ___/ __ `/ __ \ \033[0m";
    say "\033[1;36m / ___ |/ / /  / /_/ /___/ / /__/ /_/ / / / / \033[0m";
    say "\033[1;36m/_/  |_/_/_/   \__,_//____/\___/\__,_/_/ /_/  \033[0m";
    say "\033[1;32m===============================================================\033[0m";
    say "\033[1;33m[*] High-Speed Cyber Recon & Security Posture Audit Engine\033[0m";
    say "\033[1;37m[*] Language : AiraLang v1.4.0 (Native Cyber Engine)\033[0m";
    say "\033[1;35m[*] Architect: Adam Eehan (Founder & CEO, Aira Group of Tech)\033[0m";
    say "\033[1;32m===============================================================\033[0m";
    say "";
}

fn scan_target(raw_target) {
    let target = raw_target.replace("https://", "").replace("http://", "").replace("/", "");
    if (target.length == 0) {
        say "\033[1;31m[!] Error: Empty target provided.\033[0m";
        return null;
    }

    say "\033[1;34m[*] Initiating Recon Scan against: \033[1;37m" + target + "\033[0m";
    say "\033[1;90m---------------------------------------------------------------\033[0m";

    # --- Phase 1: DNS & IP Resolution ---
    say "\033[1;33m[1/4] Resolving Network Host & DNS...\033[0m";
    let ip = sec.resolve(target);
    say "      [+] Target Host : " + target;
    say "      [+] IP Address  : \033[1;32m" + ip + "\033[0m";
    say "";

    # --- Phase 2: Port Scanning ---
    say "\033[1;33m[2/4] Scanning Common Network Ports & Services...\033[0m";
    let common_ports = [21, 22, 23, 25, 53, 80, 110, 143, 443, 3306, 8080, 8443];
    let open_ports = sec.scan_ports(target, common_ports, 15, 1.2);

    if (open_ports.length == 0) {
        say "      \033[1;90m[-] No open ports found in common range.\033[0m";
    } else {
        say "      \033[1;32m[+] Discovered " + open_ports.length + " Open Port(s):\033[0m";
        for p in open_ports {
            say "          • Port " + p["port"] + " [" + p["service"] + "] -> \033[1;32mOPEN\033[0m";
        }
    }
    say "";

    # --- Phase 3: HTTP Security Headers Audit ---
    say "\033[1;33m[3/4] Auditing Web Security Headers (CSP, HSTS, etc.)...\033[0m";
    let audit = sec.audit_headers("https://" + target);
    if (audit.has("error")) {
        audit = sec.audit_headers("http://" + target);
    }

    if (audit.has("error")) {
        say "      \033[1;31m[-] Web Server Audit Notice: Target not serving HTTP/HTTPS\033[0m";
    } else {
        let grade = audit["grade"];
        let color = "\033[1;32m";
        if (grade == "C" or grade == "D") {
            color = "\033[1;33m";
        } else if (grade == "F") {
            color = "\033[1;31m";
        }

        say "      [+] Web Server     : " + audit["server"];
        say "      [+] Security Grade : " + color + "[" + grade + "]\033[0m";

        let present = audit["present"];
        let missing = audit["missing"];

        say "      [+] Active Headers (" + present.length + ")  : \033[1;32m" + present.join(", ") + "\033[0m";
        if (missing.length > 0) {
            say "      [-] Missing Headers (" + missing.length + ") : \033[1;31m" + missing.join(", ") + "\033[0m";
        }
    }
    say "";

    # --- Phase 4: Subdomain Discovery ---
    say "\033[1;33m[4/4] Discovering Public Subdomains...\033[0m";
    let subs = sec.subdomains(target, 5.0);
    if (subs.length == 0 or subs[0].contains("Error")) {
        say "      \033[1;90m[-] No subdomains returned or lookup timed out.\033[0m";
    } else {
        say "      \033[1;32m[+] Found " + subs.length + " Subdomain(s):\033[0m";
        let count = 0;
        for s in subs {
            if (count < 8) {
                say "          • " + s;
                count += 1;
            }
        }
        if (subs.length > 8) {
            say "          \033[1;90m... and " + (subs.length - 8) + " more subdomains\033[0m";
        }
    }

    say "";
    say "\033[1;32m===============================================================\033[0m";
    say "\033[1;32m[✓] Scan Complete for: " + target + "\033[0m";
    say "\033[1;90m👑 AiraScan © 2026 Adam Eehan — Aira Group of Technology\033[0m";
    say "";
}

fn main() {
    print_banner();
    let target = input("\033[1;36m[?] Enter Target Domain / IP: \033[0m");
    scan_target(target);
}

main();
